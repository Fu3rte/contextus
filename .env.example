# ================== 向量模型 ==================
# 默认按阿里云百炼（DashScope）的 OpenAI 兼容接口填。
# 想用业务空间专属域名就把 dashscope.aliyuncs.com 换成
# {WorkspaceId}.cn-beijing.maas.aliyuncs.com，{WorkspaceId} 换成你的业务空间 ID。
# 注意：百炼的 API Key 分地域，必须和 URL 同地域，否则会报 401 Incorrect API key。
EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=在这里填百炼的APIKey
# 可选 text-embedding-v4 / text-embedding-v3（默认 1024 维）
#     text-embedding-v2 / text-embedding-v1（1536 维）
EMBED_MODEL=text-embedding-v4
# 必须等于模型实际输出的维度。v4/v3 默认 1024。
# 改这个值必须重建表：docker compose down -v && docker compose up -d
EMBED_DIM=1024
# 单次 embeddings 请求最多带几条文本。百炼 v3/v4 上限就是 10，别往大调。
EMBED_BATCH_SIZE=10

# ================== 对话模型 ==================
# 填 base_url，不要带 /chat/completions，代码会自己拼。
LLM_URL=https://api.stepfun.com/v1
LLM_API_KEY=在这里填对话模型的APIKey
CHAT_MODEL=step-3.7-flash

# ================== 数据库 ==================
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rag

# ================== 切分与检索 ==================
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
